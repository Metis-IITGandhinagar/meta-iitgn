# ==============================================
# Meta IITGN - Docker Compose Environment Configuration
# ==============================================
# Copy this file to .env in the root directory when using Docker Compose:
#   cp .env.example .env

# ----------------------------------------------
# PostgreSQL Database (Docker Service)
# ----------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=wiki

# ----------------------------------------------
# Backend Configuration
# ----------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_this_to_a_secure_random_string
FRONTEND_URL=http://localhost:3603

# Google OAuth (Backend verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token

# ----------------------------------------------
# Frontend Configuration
# ----------------------------------------------
# Google OAuth (Frontend client-side login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
