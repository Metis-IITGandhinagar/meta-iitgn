# ==============================================================================
# Meta IITGN - Docker/VPS Deployment Environment Variables Template
# Copy this file to '.env' in the root directory and update the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Credentials (PostgreSQL Container)
# ------------------------------------------------------------------------------
DB_USER=postgres
# IMPORTANT: Change this to a secure, unique password for production
DB_PASSWORD=raj_secure_password_here
DB_NAME=wiki

# ------------------------------------------------------------------------------
# 2. Express Backend Environment Configuration
# ------------------------------------------------------------------------------
# Security key for signing JWTs (must match between client/server auth)
JWT_SECRET=

# Google OAuth credentials (for login features)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Integration (for media/images upload hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub integration token
GITHUB_TOKEN=

# CORS configuration (list URLs allowed to access the backend API)
# Since the frontend server proxies client browser requests on port 3000, 
# you should include the VPS URL or localhost of the frontend if calling direct.
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Google Auth Client ID (baked into frontend at build time)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
