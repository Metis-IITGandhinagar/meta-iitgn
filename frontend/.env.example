# ==============================================
# Meta IITGN Frontend - Environment Configuration
# ==============================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# ----------------------------------------------
# Backend API Configuration
# ----------------------------------------------
# In local development without Docker, set this to your backend server URL.
# If NEXT_PUBLIC_API_URL is set, client-side requests go directly here (${NEXT_PUBLIC_API_URL}/api).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Used by Next.js server-side rewrites (/api/* -> ${BACKEND_INTERNAL_URL}/api/*) and SSR requests.
# Local dev: http://localhost:3001
# Docker container: http://backend:3001
BACKEND_INTERNAL_URL=http://localhost:3001

# ----------------------------------------------
# Authentication (Google OAuth)
# ----------------------------------------------
# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
